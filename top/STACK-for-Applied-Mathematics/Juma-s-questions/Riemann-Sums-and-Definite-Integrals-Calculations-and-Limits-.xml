    <questionvariables>
      <text>aa:rand_with_step(-5,0,1);
bb:rand_with_step(1,5,1);
var1:rand(2)+1; 
func1:x^(var1);
func2:expand((x-aa)*(x-bb));
func3:expand((x+aa)*(x+aa));
func:rand([func1,func2,func3]);

/*Solutions of the steps*/
ta1:(bb-aa)/n;
ta2:aa+ta1*j;
ta3:subst(ta2,x,func);
f_xj:expand(ta3*ta1);

coef_j0:coeff(f_xj,j,0);
coef_j:coeff(f_xj,j);
coef_j2:coeff(f_xj,j^2);

sum_j:(n*(n+1))/2;
sum_j2:(n*(n+1)*(2*n+1))/6;

ta4:expand(coef_j2*sum_j2+coef_j*sum_j+coef_j0);

ta5:int(func,x,aa,bb);</text>
    </questionvariables>
