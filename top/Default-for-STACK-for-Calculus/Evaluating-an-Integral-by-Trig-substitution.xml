    <questionvariables>
      <text>/*Static Question variable*/
coef1: rand(5)+2;
coef2:rand_with_prohib(0,5,[0,coef1]);
coef3:rand_with_prohib(0,5,[0,coef1,coef]);
num_func:(coef1)^2*x^2-(coef2)^2;
denom_func:coef3*x;
question_func: sqrt(num_func)/denom_func;

/*Model answer*/
/*ta:int(question_func,x)+c;*/ 

/*Worked soln*/
let_x:coef2*sec(theta)/coef1;
diff_let_x:diff(let_x)/del(theta);
new_expr_subst_let_x:subst(let_x,x,sqrt(num_func));
factor_new_expr_subst_let_x:factor(new_expr_subst_let_x);
expr_interms_of_tan:subst((tan(theta))^2,(sec(theta))^2-1,factor_new_expr_subst_let_x);
expr_interms_of_tan_no_abs:args(args(expr_interms_of_tan)[2])[1];
expr_interms_of_tan_no_abs1:coef2*expr_interms_of_tan_no_abs;

new_question_func_trig:new_question_func_trig:((expr_interms_of_tan_no_abs1)/(coef3*let_x))*diff_let_x;

int_new_question_func_trig:int(new_question_func_trig,theta)+c;

expression_sin_theta:args(solve(x=let_x,sec(theta)))[1];
expression_sin_theta_rhs:rhs(expression_sin_theta);
expression_tan_trig:(tan(theta))^2+1=expression_sin_theta_rhs^2;
solve_tan_expression_tan_trig:args(solve(expression_tan_trig,(tan(theta))^2))[1];
solve_tan_expression_tan_trig1:args(solve(solve_tan_expression_tan_trig,tan(theta)))[2];
solve_theta_expression_tan_trig1:args(solve(solve_tan_expression_tan_trig1,theta))[1];

solve_tan_expression_tan_trig1_rhs:rhs(solve_tan_expression_tan_trig1);
subst_tan_theta_int_new_question_func_trig:subst(solve_tan_expression_tan_trig1_rhs,tan(theta),int_new_question_func_trig);
solve_theta_expression_tan_trig1_rhs:rhs(solve_theta_expression_tan_trig1);
final_answer_subst:subst(solve_theta_expression_tan_trig1_rhs,theta,subst_tan_theta_int_new_question_func_trig);
ta:final_answer_subst;</text>
