rdm2:1+rand(49);
rdm3:2+2*rand(13);
pp:sin(rdm1*v)*cos(rdm2*v);
p:rdm3*pp;
q:(sin(rdm1*v+rdm2*v) + sin(rdm1*v-rdm2*v))/2;
ta: int(p,v)+c;</text>
