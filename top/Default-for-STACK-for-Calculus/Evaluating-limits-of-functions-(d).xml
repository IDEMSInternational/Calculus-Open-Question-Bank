    <questionvariables>
      <text><![CDATA[var_1:rand(10)+(3/2);/*constant in the numerator*/
var_limit:rand([0,1]);
eqn: (sin(%pi * var_1)) / x;
eqn_1: (sin(%pi * (var_1-2)));
ta_1:limit(eqn, x, var_limit);
if var_limit = 0 then ta: "undefined" else ta: ta_1;]]></text>
