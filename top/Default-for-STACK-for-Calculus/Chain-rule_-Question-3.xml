    <questionvariables>
      <text>/*Question variables*/
aa:rand_with_prohib(1,5,[]);
bb:rand_with_prohib(1,5,[]);
cc:rand_with_prohib(1,5,[]);
dd:rand_with_prohib(-5,5,[0]);
ee:rand_with_prohib(-5,5,[0]);

func_z:dd*x^(aa)+ee*y^(bb);
func_y:sin(x^cc);

/*Worked solution*/
func1:diff(func_z,x); 
func2a:diff(func_z,y);  
func2b:diff(func_y,x);

ta:func1+func2a*func2b;


/*mistakes*/
node_2_testx:diff(func_z,x);</text>
