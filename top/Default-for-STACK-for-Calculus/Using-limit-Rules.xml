coef2:rand_with_prohib(-4,4,[coef1]);
pwr:coef1/coef2;
limit_point:rand(4);
f(x):= a1; 
g(x):= a2; 
expr: (coef1*f(x) - g(x))/((f(x) + const)^(pwr)); 
ta1:limit(expr, x, limit_point);

ta2:random_permutation([["Limit of a Sum or Difference",false],["Limit of a Constant",false],["The Quotient Rule for Limits",true],["Limit of a Product",false ]]);

ta3:random_permutation([["L'Hôpital's Rule",false],["The Fundamental Theorem of Calculus",false],["The Sum and Difference Rule for Limits",true],["Limit of a Composite Function",false]]);

ta4:random_permutation([["Continuity of a Function",false],["The Mean Value Theorem",false],
    ["Limit of a Constant",true],["The Sum and Difference Rule for Limits",true],["Power rule for limits",true]]);
]]></text>
