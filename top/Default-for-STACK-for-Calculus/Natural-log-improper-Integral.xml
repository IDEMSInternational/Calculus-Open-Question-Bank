    <questionvariables>
      <text><![CDATA[/*new improper questions*/
upper_lmt:rand(5)+1;
lower_lmt:0;
func:x*log(x);
/*worked solution*/
expr_u:log(x);
du:diff(expr_u,x);
expr_dv:x;
expr_v:int(expr_dv,x);
part_uv:expr_u*expr_v;
part_vdu:expr_v*du;
int_vdu:int(part_vdu,x);
int_parts:part_uv-int_vdu;
upper:subst(x=upper_lmt,int_parts);
lower:subst(x=t, int_parts);
ta1:upper;

/*Model answers*/
ta_2:if ta1=upper then "Convergent" else "Divergent";
ta_3:if ta_2="Divergent" then "Convergent" else "Divergent";
ta_4:random_permutation([[ta_2, true],[ta_3, false],["Divergent and convergent", false]]);]]></text>
    </questionvariables>
