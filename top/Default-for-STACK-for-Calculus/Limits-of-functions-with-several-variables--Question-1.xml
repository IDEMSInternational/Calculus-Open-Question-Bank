    <questionvariables>
      <text>aa:rand_with_step(1,4,1); bb:rand_with_step(1,4,1); cc: rand_with_step(1,4,1);
num_func:aa*x^bb-z*e^(cc*y);  /*numerator function*/
denom_func:aa*x+bb*y-cc*z;  /*denomenator function*/
question_func:num_func/denom_func;
var_x: rand(3)+1; var_y:rand_with_step(-3,3,1); var_z:rand_with_step(-3,3,1); /*limit points*/
ta1:limit (question_func, x, var_x);
  
ta2:limit (ta1, y, var_y);

ta:ratsimp(limit (ta2, z, var_z));</text>
    </questionvariables>
