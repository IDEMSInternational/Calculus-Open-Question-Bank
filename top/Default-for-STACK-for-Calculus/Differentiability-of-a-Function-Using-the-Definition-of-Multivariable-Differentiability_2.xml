    <questionvariables>
      <text>/*Defining randomised coefficients for the functuon z*/
aa: rand_with_prohib(-5,5,[0]);
bb: 3;
cc: 1;
dd: 1;
ee: 2;
/*Define the function z=f(x,y)*/
f_xy: aa*x^cc*y^dd+bb*y^ee;

/*Model answers*/
ta_1: expand(at(f_xy, [x=x+dx, y=y+dy])); /*Evaluate f(x+dx, y+dy)*/
ta_2: ta_1-f_xy; /*evaluate Delta z = f(x+dx, y+dy)-f(x,y)*/
ta_3: diff(f_xy,x); /*partial derivative of f wrt x*/
ta_4: diff(f_xy,y); /*partial derivative of f wrt y*/
expr: (1/dy)*factor(ta_2 -(ta_3*dx+ta_4*dy)); /*For getting E1*(dx/dy)+E2*/
expr1: expand(ta_2 -(ta_3*dx+ta_4*dy)); /*For getting E2*(dy/dx)+E1*/
expr2: subst(0,dy^2,expr1);
ta_6: at(expr, [dx=0]); /*Expression corresponding to E2*/
ta_5: at(expr2,[dy=1]); /*Expression corresponding to E1*/
ta_7: at(ta_5, [dx=0, dy=0]); /*Evaluating limit of E1, when (dx, dy) tends to (0, 0)*/
ta_8: at(ta_6, [dx=0, dy=0]); /*Evaluating limit of E2, when (dx, dy) tends to (0, 0)*/</text>
    </questionvariables>
