    <questionvariables>
      <text>/*Defining randomised coefficients for the functuon z*/
aa: rand_with_prohib(-7,7,[0]);
bb: rand_with_step(2,5,1);
cc: rand(5)+2;
/*Define the function z=f(x,y)*/
f_xy: aa*x^bb*%e^(cc*y);

/*Model answers*/
ta_1: diff(f_xy,x); /*partial derivative of f wrt x */
ta_2: diff(f_xy,y); /*partial derivative of f wrt y*/
ta_3: ta_1*dx+ta_2*dy; /*total differential of z, dz*/


/*possible mistakes*/
ta_4: ta_1*dx-ta_2*dy; /*total differential of z, dz*/</text>
    </questionvariables>
