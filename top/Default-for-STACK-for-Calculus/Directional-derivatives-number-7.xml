    <questionvariables>
      <text>/*defining question variables*/
point_x: rand_with_step(1,3,1); point_y: rand_with_prohib(-2,2,[0]); 
point_z: rand_with_step(-1,2,1);
var_ex:rand(2)+1;
var_z:rand(2)+1;
var_cos:rand([cos,sin]);
quiz_expr:(e^(var_ex*x))*var_cos((y-(var_z)*z));
/*differentiation*/
function_1:diff(quiz_expr,x);
function_2:diff(quiz_expr,y);
function_3:diff(quiz_expr,z);
/*gradient point x */
gradient1a:subst(point_x,x,function_1);
gradient1b:subst(point_y,y,gradient1a);
gradient1:subst(point_z,z,gradient1b);
/*gradient point y */
gradient2a:subst(point_x,x,function_2);
gradient2b:subst(point_y,y,gradient2a);
gradient2:subst(point_z,z,gradient2b);
/*gradient point z */
gradient3a:subst(point_x,x,function_3);
gradient3b:subst(point_y,y,gradient3a);
gradient3:subst(point_z,z,gradient3b);
ta7:decimalplaces(float(gradient1),1);
ta8:decimalplaces(float(gradient2),1);
ta9:decimalplaces(float(gradient3),1);
/*magnitude*/
magnitude:decimalplaces((sqrt((ta7)^2+(ta8)^2+(ta9)^2)),1);</text>
    </questionvariables>
