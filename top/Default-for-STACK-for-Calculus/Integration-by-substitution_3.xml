    <questionvariables>
      <text>/*Defining the question*/
numerator:rand(9)+2;/*random number for the numerator*/
constant_denom_1:rand(7)+1;/*random number for the constant of the denominator*/
coeff_denom_2:rand(5)+1;/*random number for the coefficient of t in the denominator*/
power:rand(9)+2;/*random value of n outside the root sign*/
f_t:numerator/((constant_denom_1-coeff_denom_2*t)^(1/power));/*the function*/
g_t:((-1/coeff_denom_2)*numerator)/((u)^(1/power));/*the function depending of the variable*/


/*Model answers*/
ta_1:int(f_t,t)+c;

/*Worked solution*/
tas:int(g_t,u)+c;</text>
