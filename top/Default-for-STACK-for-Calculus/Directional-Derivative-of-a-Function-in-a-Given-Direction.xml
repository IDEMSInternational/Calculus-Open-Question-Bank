    <questionvariables>
      <text>/*Defining the question*/
point_x:rand(4)-5; point_y:rand(5)+2; point_z:rand(5); /*direction vector v*/ coef1:rand(5);
function: f(x,y,z)=x^2*y^3-coef1*x*z;
gradient_x:diff(rhs(function),x);
gradient_y:diff(rhs(function),y);
gradient_z:diff(rhs(function),z);
gradient_F:[gradient_x,gradient_y,gradient_z];
norm_v:sqrt(point_x^2+point_y^2+point_z^2);
unit_vectorv:[point_x/norm_v,point_y/norm_v,point_z/norm_v];
directional_derivative:(gradient_x*point_x/norm_v+gradient_y*point_y/norm_v+gradient_z*point_z/norm_v);
/*Model answers*/
ta_1:gradient_x;
ta_2:gradient_y;
ta_3:gradient_z;
ta_4:norm_v;
ta_5:unit_vectorv;
ta_6:directional_derivative;</text>
