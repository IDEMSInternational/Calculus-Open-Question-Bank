    <questionvariables>
      <text>/*Defining the question*/
lower_x:rand(4);
upper_x:lower_x+rand(3)+1;
lower_y:rand(3);
upper_y:sqrt(rand(9)+lower_y);
coeff_x:rand(4)+2;
power_e:y^2-coeff_x*x;
question_expr:y*%e^(power_e);/*the function*/
int_y:int(question_expr,y,lower_y,upper_y); /*wrt y*/
int_x:int(int_y,x,lower_x,upper_x); /*wrt x*/

/*Worked solution*/
let_u:power_e;
diff_u:du=diff(let_u,y)*dy;
var_y:solve(diff_u,y)[1];
expr1:(rhs(var_y)*%e^u)*dy;
int_xx:int(int_y,x); /*wrt x*/

/*Model answers*/
ta1:int_y;
ta2:decimalplaces(int_x,2);</text>
    </questionvariables>
