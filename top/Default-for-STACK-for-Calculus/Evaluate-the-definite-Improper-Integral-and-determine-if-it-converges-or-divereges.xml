    <questionvariables>
      <text><![CDATA[/*Defining the question variables*/
const1:rand_with_step(-2,4,1); /*constant in the function*/
coef_x:rand_with_step(-4,2,1); /*coefficient of x*/
coef_power:rand_with_step(-5,4,1); 
func:(const1+coef_x*x)*%e^(-coef_power*x);  /*the function*/
lower_limit:minf;
upper_limit:0;

/*worked out solution code*/
let_u:(const1+coef_x*x); du:diff(const1+coef_x*x)/del(x);
var_v:int(%e^(-coef_power*x),x); dv:(%e^(-coef_power*x)); v_du:int((var_v*du),x);
u_dv:(let_u*var_v-v_du);
expr1:subst(0,x,u_dv); 
expr2:subst(t,x,u_dv); 
expr3:(expr1-expr2);
expr4:expand(expr3);
expr3_factor: factor(expr3);
expr5: if -coef_power>0 then expr4 else expr3_factor;


/*Model answer*/
ta: int(func,x,t,upper_limit);  
ta_1: limit(ta,t,lower_limit);
ta_2:if ta_1=minf then "Divergent" elseif ta_1=inf then "Divergent" else"Convergent";
ta_3:if ta_2="Divergent" then "Convergent" else "Divergent";
ta_4:random_permutation([[ta_2, true],[ta_3, false],["Divergent and convergent", false]]);]]></text>
    </questionvariables>
