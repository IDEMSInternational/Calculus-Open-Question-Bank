  <question type="stack">
    <name>
      <text>Limit Calculation of a Function</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p></p><p>Find \(\displaystyle \lim_{x \rightarrow {@lim@}} {@fx@}\). Give your answer in exact form. If the limit doesn't exist enter NO as your answer.</p><p>[[input:ans1]] [[validation:ans1]]</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text/>
    </generalfeedback>
    <defaultgrade>1</defaultgrade>
    <penalty>0.1</penalty>
    <hidden>0</hidden>
    <idnumber/>
    <stackversion>
      <text>2022071300</text>
    </stackversion>
    <questionvariables>
      <text>simp:false;
aa:ev(rand(5)+2,simp);
numer:sqrt(x+1)-aa;
numer2:sqrt(x+1)+aa;
lim:ev(aa^2-1,simp);
denom:x-lim;
fx:numer/denom;
ta:rat(ev(1/(2*aa),simp));</text>
    </questionvariables>
    <specificfeedback format="html">
      <text>[[feedback:prt1]]</text>
    </specificfeedback>
