    <questionvariables>
      <text>aa: 3+rand(4); bb: 2+aa;
func_var_u:e^(aa*x); /*this is what will become  u in the question func*/
func_var_dv:cos(aa*x/bb);  /*varible for dv in the question func*/
question_func:(func_var_u)*((func_var_dv)); /* questoin expression in terms of u \times dv*/
/*model answer*/
ta:trigreduce(int(question_func,x)+c); /*force simplification of model answer*/

/*Worked out solution codes*/
diff_u:diff(func_var_u)/del(x);    /* derivative of var_u */
int_v: trigreduce(int(func_var_dv,x));    /* integral of dv to get v */
v_du: int_v*diff_u;       /* product  (diff_u and int_v) */
int_v_du: int(v_du,x);  /* integral of _ product  (diff_u and int_v) */
sol1:
/*model answers*/
ta1a:func_var_u;
ta1b:func_var_dv;
ta1c:diff_u;
ta1d:int_v;
u_dv:func_var_u*func_var_dv;
ta2a:simplify(func_var_u*int_v);
ta2b:simplify(int_v*diff_u);
/*ta2c:int_v;*/
/*ta2d:func_var_dv;*/
ta3a:diff_u;
ta3b:int_v;
ta3c:diff(diff_u,x);
ta3d:int(int_v,x);
ta4a: (diff_u)*(int_v); /*s*t*/
ta4b:(ta3c)*(ta3d); /*t*ds*/
</text>
