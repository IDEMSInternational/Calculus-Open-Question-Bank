    <questionvariables>
      <text><![CDATA[/* Define the constants and variables */
num:rand(10)+1;
power:rand(5)+2;
upper_lm:inf;
lower_lm:rand(5)+1;
limit_pt:t;
den:x^power;
fx : num/den;

/* Compute the indefinite integral */
indef_int: int(fx, x);

/* Compute the definite integral from 1 to t */
upper:at(indef_int,x=limit_pt);
lower:at(indef_int,x=lower_lm);
indef_val: upper-lower;

/* Compute the definite integral from 1 to infinity */
def_integral: limit(indef_val, limit_pt, inf);

/*Model answers*/
ta_1: limit(indef_val, limit_pt, inf);
ta_2:if ta_1=upper_lm then "Divergent" elseif ta_1=minf then "Divergent" else"Convergent";
ta_3:if ta_2="Divergent" then "Convergent" else "Divergent";
ta_4:random_permutation([[ta_2, true],[ta_3, false],["Divergent and convergent", false]]);
]]></text>
    </questionvariables>
