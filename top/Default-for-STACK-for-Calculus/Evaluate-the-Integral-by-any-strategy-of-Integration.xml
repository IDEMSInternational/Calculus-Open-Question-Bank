    <questionvariables>
      <text>/*Defining the question variables*/
aa:rand(5)+1;/*the constant in the numerator*/
bb:(1+rand(2))^2;/*the perfect square in the root*/
 lower_limit:rand(10)+2;
 upper_limit:rand(10)+1+lower_limit;
/* lower_limit:%pi/9;*/ /*upper_limit:rand([%pi,%pi/4,3*%pi/4,%pi/3,2*%pi/3,%pi/6,5*%pi/6,7*%pi/8,3*%pi/8,5*%pi/8]);*/
func:aa/(y^4*sqrt(y^2-bb));
ff:int(func,y,lower_limit,upper_limit);

/*Model answer*/
ta:decimalplaces(float(ff),4);


/*solving secant*/
num:lower_limit;
den:sqrt(bb);
tt:asec(num/den);
ta_1:decimalplaces(float(tt),4);
num_1:upper_limit;
tt_1:asec(num_1/den);
ta_2:decimalplaces(float(tt_1),4);
dd:sin(ta_1);
ta_3:decimalplaces(float(dd),4);
ee:sin(ta_2);
ta_4:decimalplaces(float(ee),4);</text>
