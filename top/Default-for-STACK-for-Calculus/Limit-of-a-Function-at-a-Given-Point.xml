pm2:rand_with_prohib(-1,1,[0]);
cc:rand(2)+2;
bb:pm2*(rand_with_prohib(1,7,[cc,2*cc,3*cc,4*cc]));
numer:expand((cc*x-bb)*(x-aa))
fx:numer/(x-aa);
ta:ev((cc*x-bb),x=aa);

/* Worked solution - unevaluated lines*/
simp:false;
line1:cc*aa + bb;
line2:ev(cc*aa,simp) - bb;
simp:true;</text>
