      <text>/*mean value theorem*/
constant_2:rand(3)+2;
quest_expr1:x/constant_2;
a:rand(3);
b2:a+2+rand(8);
/*worked solution 1*/
solution1:int(quest_expr1,x);
sol1:int(quest_expr1,x,a,b2);
sol2:(1/(b2-a))*sol1;
ta1a: sol2;
sol3:subst(c,x,quest_expr1);
sol4:solve(sol2=sol3)[1];
ta1:rhs(sol4);</text>
