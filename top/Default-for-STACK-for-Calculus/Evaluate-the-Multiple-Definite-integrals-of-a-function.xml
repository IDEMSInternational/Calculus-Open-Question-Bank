    <questionvariables>
      <text>/*Random generating and calculating variables*/

root_1:(rand(5)+1); /*positive root*/
f_x:expand(-(x-root_1)*(x+root_1)); /*define the function from its roots*/

limit_1:rand_with_step(0,root_1-1,1); 
limit_2:root_1;
limit_3:rand_with_step(root_1+1,root_1+5,1);

/*model answers*/
ta_1:int(f_x,x,limit_1,limit_2);
ta_2:int(f_x,x,limit_1,limit_3);
ta_3:int(f_x,x,limit_3,limit_2);
ta_4:ta_2+ta_3;

/*Worked solution variables*/
coeff_x_2:coeff(f_x,x,2);
coeff_x_0:coeff(f_x,x,0);</text>
    </questionvariables>
