    <questionvariables>
      <text>/* Define the function */
var_x:rand(8)+2;
power:rand(3)+1;
trig:rand([sin,cos,tan]);
func1:var_x*x^power;
diff_func1:diff(func1,x);
func2:rand([trig(x),e^x,(x-1)^2,(e^(-2*x)),(x+3)^2]);
diff_func2:diff(func2,x);

f(x) := func1 * func2;

/* Find the derivative */ 
ta : diff(f(x), x);  
ta2:diff(ta,x);</text>
    </questionvariables>
