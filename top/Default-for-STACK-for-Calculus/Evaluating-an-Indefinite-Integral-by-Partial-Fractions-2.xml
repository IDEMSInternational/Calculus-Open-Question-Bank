    <questionvariables>
      <text>/*Defining the question*/
aa:2+ rand(3);
bb: 1+rand(2);
const_1:1+rand(5);/*The first constant coefficient*/
const_2:1+rand(5);/*The second constant*/
const_3:1+rand(4);/*The third constant*/
const_4:1+rand(8);/*The fourth constant*/
zz1:rand_with_prohib(-7,7,[0]);/* numerator_1*/
zz2:rand_with_prohib(-7,7,[0]);/* numerator_2*/
zz3:rand_with_prohib(-7,7,[0]);/* numerator_2*/
part_frac_1:zz1/x;/*The first Partial fraction*/
part_frac_2:zz2/(x+const_1*const_2);/*The second Partial fraction*/
part_frac_3: x^aa+zz3*x^bb+const_3;/*The third Partial fraction*/
question_expression: factor(part_frac_1+part_frac_2+part_frac_3);

/*model answer question 1*/
ta_1:part_frac_1;
ta_2:part_frac_2;
ta_3:part_frac_3;
ta_4: ta_1+ta_2+ta_3;
ta_1a: partfrac(question_expression,x);

/*Worked solution codes for question 1 */
part_frac_A:A/x;
part_frac_B:B/(const_1*x+const_2);
part_frac_C:C;
expr5: factor(ta_1+ta_2);
numerator_question_expression:num(expr5);
expr: A*(const_1*x+const_2)+B*x=numerator_question_expression;

/*Find A and B/*
expr1:ev(expr,x=0);
expA:expr1/ev(((const_1*x+const_2)),x=0);
expr2:ev(expr,x=-const_3);
expC:expr2/ev((x*(const_1*x+const_2)),x=-const_3);
coef_B:ev((-const_2/const_1),simp);
expr3b:ev(expr,x=coef_B);
expB:expr3b/ev(x*(x+const_3),x=(-const_2/const_1));

expa:question_expression=ta_4;

/*model answer part b*/
int_part1:int(ta_1,x);
int_part2:int(ta_2,x);
int_part3:int(ta_3,x);
ta1: ta_3;
ta2: expr5;
ta4:int_part1+int_part2+int_part3+c;</text>
    </questionvariables>
