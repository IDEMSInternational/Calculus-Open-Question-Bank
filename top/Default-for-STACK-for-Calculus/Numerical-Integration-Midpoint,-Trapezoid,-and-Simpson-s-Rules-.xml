    <questionvariables>
      <text>/*Defining the question wrt to its limits a (lower limit) and b (upper limit)*/
a: rand([1,2]);
b: rand([7,8]);
n: rand([4,6,8]);
delta_x: (b-a)/n;
x(i):=a+i*delta_x;
f(x):=rand([1/(x^3+1), 3/(x^4-5)]);
/*Formula for midpoint*/
m(i):=(x(i-1)+x(i))/2;
sum_mid: sum(f(m(i)),i,1,n);
Mid_n: sum_mid*delta_x;

/*Find list of midpoints and endpoints*/
all_midpoints: makelist(m(i),i,n);
all_endpoints: makelist(x(i),i,0,n);

/*Formula for trapezoidal rule*/
sum_trap: sum(f(x(i)),i,1,n-1);
Trap_n: (delta_x/2)*(f(a)+2*sum_trap+f(b));

/*Formula for Simpson'rule*/
z:(n/2);
delta_z: (b-a)/z;
x(j):=a+j*delta_z;
m(j):=(x(j-1)+x(j))/2;
sum_mid_z: sum(f(m(j)),j,1,z);
Mid_z: sum_mid_z*delta_z;
sum_trap_z: sum(f(x(j)),j,1,z-1);
Trap_z: (delta_z/2)*(f(a)+2*sum_trap_z+f(b));
Simp_n: (2/3)*Mid_z+(1/3)*Trap_z;

/*Model answers*/
ta:decimalplaces(float(int(f(x),x,a,b)),4);
ta_1: decimalplaces(float(Mid_n),4);
ta_2: decimalplaces(float(Trap_n),4);
ta_3: decimalplaces(float(Simp_n),4);
m_error:decimalplaces(ta-ta_1,4);
t_error:decimalplaces(ta-ta_2,4);
s_error:decimalplaces(ta-ta_3,4);</text>
    </questionvariables>
