    <questionvariables>
      <text><![CDATA[aa:rand(6)+1; bb:rand_with_step(-6, 6, 1); cc:rand(4)+2; dd:rand(8)+2; /*random variables for the coefficients*/

func_num:(aa*x^2*y+bb*x*y);    /*numerator func*/
func_denom:cc*x*y^2+(dd)*y;  /*denominator func*/
question_func:func_num/func_denom;  /* question function*/

var_x:rand(6)+3;  
var_y:rand_with_prohib(1,8,[var_x]); /*limit points for x and y*/

/*Worked solution variables*/
ta_1a:limit (func_denom, x, var_x); /*subst for x with var_x*/
ta1:limit (ta_1a, y, var_y);  /*subst for y with var_x_  input ans 1*/

ta_2a:limit (question_func, x, var_x);  /*subst for x with var_x in the question_func*/
ta2:limit(ta_2a, y,var_y);   /*subst for y with var_y_ input ans 2*/

ta3a: if ta2#0 then  "exists" else "doesn't exist";
ta3:[[ta3a, true],["Doesn't exist", false]];
]]></text>
