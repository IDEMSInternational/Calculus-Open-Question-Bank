    <questionvariables>
      <text>/*Defining the question*/
coeff_numerator:rand(8)+2;/*random number for the coefficient of x in the numerator*/
constant_denom:rand(7)+1;/*random number for the constant of the denominator*/
power:rand(9)+2;/*random value of n outside the root sign*/
f_x:coeff_numerator*x/((x^(2)-constant_denom)^(1/power));/*the function*/
g_x:(1/(2*x))*coeff_numerator*x/((u)^(1/power));/*the function*/


/*Model answers*/
ta_1:int(f_x,x)+c;
tas:int(g_x,u)+c;</text>
