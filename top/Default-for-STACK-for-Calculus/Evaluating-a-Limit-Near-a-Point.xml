point:rand_with_prohib(-10,10,[0]);
simp:false
fx:(x-aa)^2/(x-aa);
fsimp:ev(fx,simp);
tad:ev(fsimp,x=point);
ta:ev(tad,simp);
sign_ev:if aa>0 then "-" else "+";
]]></text>
