    <questionvariables>
      <text><![CDATA[/* random parameters */
pars:[1+rand(9),1+rand(6)]
lb:rand_with_prohib(1,9,[pars[1]])
n:rand_with_prohib(2,9,[lb])
ub:x^n

/* Randomize function */
f:rand([sqrt(pars[1]+t^pars[2]),sqrt(t^pars[2] + pars[1]*t),exp(-t^pars[2]),ln(pars[1]+t^pars[2]),t^pars[1]/(1+t^pars[2]),cos(t^3)*t^n,sin(t^2)*exp(-t^pars[2])])

ta1:[[1,true,"Fundamental Theorem of Calculus"],[2,false,"Fundamental assumption of Calculus"],[3,false,"The Mean Value Theorem for Integrals"],[4,false, "Chain rule of Calculus"],[5,false, "The boundedness theorem"]] 
ta1:random_permutation(ta1)

 ta2:[[1,true,"Continuous and bounded"],[2,false,"Continuous and unbounded"],[3,false,"Discontinuous and unbounded"],[4,false,"Discontinuous and bounded"]] 
ta2:random_permutation(ta2)

/* Chain rule method for composite function */
ta3:"Chain rule"
ta31:[[1,true,"pars[1] function"], [2,false,"unknown"], [3,false,"not given"], [4,false,"not pars[1] value"]]
ta31:random_permutation(ta31)

/* assumed function of u */
assf:u=x^n

/* Differential */
dif:du=n*x^(n-1)*dx
du1:n*x^(n-1)
usubf:ev(f,t=u)
simpf:ev(usubf,u=rhs(assf))

/* changing variable t to x*/
fa:simpf*du1]]></text>
