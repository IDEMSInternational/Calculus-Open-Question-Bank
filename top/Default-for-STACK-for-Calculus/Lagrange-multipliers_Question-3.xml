    <questionvariables>
      <text><![CDATA[/*Defining the Question*/
/*Randomize the f,d*/
a:(rand(8)+1)^2;
b:(rand_with_prohib(1, 3, [a]))^2;
c:rand(5)+1;
p_sq:(rand(6)+10)^2;
d:p_sq*b;
f:rand(6)-10; /*10*/
fx:y^2+f*z;
gx:x^2+y^2+z^2=d;
/*Worked solution*/
largest_rangex: subst(0,y^2,gx);
largest_rangex1: subst(0,z^2,largest_rangex);
x_ranges:solve(largest_rangex1);
eqn1:diff(fx,x)=diff(lhs(gx),x)*lambda;   /* system of equations*/
eqn2:diff(fx,y)=diff(lhs(gx),y)*lambda;
eqn3:diff(fx,z)=diff(lhs(gx),z)*lambda;
constraint_eqn:gx;
solv_eqn1:2*y-2*y*lambda-2*y*(1-lambda)=0; /*Rewriting the second equation gives*/
solv_eqn2:y=rhs(subst(1,lambda,solv_eqn1)); /*y=0 or λ=1*/
y_1:rhs(solv_eqn2); lambda:1;
eqn4: subst(0,x^2,largest_rangex);
z_1:solve(eqn4); /*values of z*/
absolute_extrema_z1:z_1[1];
absolute_extrema_z2:z_1[2];
absolute_extrema_z:[0,0,rhs(absolute_extrema_z1)] and [0,0,rhs(absolute_extrema_z2)];
z_2:solve(ev(eqn3,lambda=1),z)[1]; /*When λ=1 using eqn 3*/
constraint_yz: solve(subst(rhs(z_2),z,subst(0,x,constraint_eqn)),y);
absolute_extrema_y1:constraint_yz[1];
absolute_extrema_y2:constraint_yz[2];
absolute_extrema_yz:[0,rhs(absolute_extrema_y1),rhs(z_2)] and [0,rhs(absolute_extrema_y2),rhs(z_2)];
absolute_extrema_z:[0,0,rhs(absolute_extrema_z1)] and [0,0,rhs(absolute_extrema_z2)];
globalmax:subst(rhs(z_2),z,subst(rhs(absolute_extrema_y1),y,fx));
globalmaxx:subst(rhs(z_2),z,subst(rhs(absolute_extrema_y2),y,fx));/*absolute maximum*/
globalmin:subst(rhs(absolute_extrema_z1),z,subst(0,y,fx));
globalminn:subst(rhs(absolute_extrema_z2),z,subst(0,y,fx));/*absolute minimum*/
/*Model answers*/
ta1s:random_permutation([["compact", true],["compact and unbounded", false], ["open region", false]]);
ta1ss:random_permutation([[" has absolute extrema ", true],[" does not have absolute extrema ", false],["does not have local extrema", false]]);
ta1:eqn1;
ta2:eqn2;
ta3:eqn3;
ta4:constraint_eqn;
ta5:y_1;
ta6:lambda;
ta7:rhs(absolute_extrema_z2);
ta8:matrix([0],[0],[rhs(absolute_extrema_z1)]);
ta9:matrix([0],[0],[rhs(absolute_extrema_z2)]);
ta10:rhs(z_2);
ta11:rhs(absolute_extrema_y2);
ta12:matrix([0],[rhs(absolute_extrema_y1)],[rhs(z_2)]);
ta13: matrix([0],[rhs(absolute_extrema_y2)],[rhs(z_2)]);
ta14:globalmaxx;
ta15:globalminn;]]></text>
