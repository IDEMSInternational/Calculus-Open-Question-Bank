cc:rand(5)+1; /*variable cc is a random number between 1 to 5 - sum it to the others */
f_t: aa*t^(bb)+cc; /*function expression*/

ta:int(f_t,t)+c; /*model answer*/

mistake_1_n2:int(f_t,t);</text>
