[4, false, "The function that evaluates \\( \\log_{10}(x) \\) raised to the power of \\( x \\),  expressed as \\(\\displaystyle 10^{\\log_{10}(x)^{x}} \\)"]],2);

ta_3:random_permutation(append(correct_answer3,incorrect_answers3));

ta_index_3: sort(makelist(x[1], x, ta_3));]]></text>
