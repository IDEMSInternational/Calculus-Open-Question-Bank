    <questionvariables>
      <text>/*Defining the question*/
coef1:rand(7)+1;/*coeffient of the root*/
const:rand(3)+1;/*coeffient constant inside the root*/
lower_y:rand_with_step(1,9,3);/*lower lmit of y*/
upper_y:rand_with_step(15,24,3);/*upper lmit of y*/
expr:y=coef1*(const+x)^(3/2);
dy:rhs(diff(expr)/del(x));
ds:sqrt(1+(dy)^2);
expr1:ev(expr,y=lower_y);
x_1:solve(expr1,x)[3];
rhs_x1_1: rhs(x_1),simp;
rhs_x1: ratsimp((lower_y/coef1)^(2/3)-const);
expr2:ev(expr,y=upper_y);
x_2:solve(expr2,x)[3];
rhs_x2_2: rhs(x_2);
rhs_x2: ratsimp((upper_y/coef1)^(2/3)-const);
ds_1:(factor(sqrt(1+dy^2)));
arc_length:int(ds_1,x,rhs_x1,rhs_x2);

/*Model answer*/
ta:decimalplaces(float(arc_length),2);</text>
