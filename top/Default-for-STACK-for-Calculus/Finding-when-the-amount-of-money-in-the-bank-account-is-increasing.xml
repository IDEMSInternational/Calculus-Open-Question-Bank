    <questionvariables>
      <text><![CDATA[/* Define the function P(t) */ 
time:rand(10)+10;
c1:(rand(5)+5)*100;
c2:rand_with_step(100,500,50);
c3:rand_with_step(100,500,50)+50;
pt : c1 + c2*cos(t) - c3*sin(t);  
dpt :diff(pt, t);  
sol: solve(dpt =0, t); 
lhs_sol:lhs(sol[1]);
rhs_sol:rhs(sol[1]);
coef1:coeff(rhs_sol,cos(t),1);
sol_tan:atan(coef1);
tpi:%pi;
t1:tpi+sol_tan;
t2:t1+tpi;
t3:t2+tpi;
t4:time;
ta1: t1<t and t<t2; alt_ta1:decimalplaces(t1,4)<t and t<decimalplaces(t2,4);
ta2: t3<t and t<t4; alt_ta2:decimalplaces(t3,4)<t and t<t4;]]></text>
    </questionvariables>
