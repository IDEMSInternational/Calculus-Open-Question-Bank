bb:rand(9)+1;
seq:aa*n/(n^2-bb);

/*Model answers*/
ta1:subst(0,n,seq);
ta2:subst(1,n,seq);
ta3:subst(2,n,seq);
ta4:subst(3,n,seq);
ta5:subst(4,n,seq);</text>
    </questionvariables>
