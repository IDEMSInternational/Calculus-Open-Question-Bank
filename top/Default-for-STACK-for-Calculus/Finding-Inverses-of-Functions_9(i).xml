    <questionvariables>
      <text>/*finding inverses*/
const:rand(6)+4;
power:rand(3)+6;
func:const*%e^(x^power);
/*worked solution variables*/
sol1:x=const*%e^(y^power);
sol2:x/const=%e^(y^power);
sol3:log(x/const)=(y^power);
sol4:(log(x/const))^(1/power);</text>
