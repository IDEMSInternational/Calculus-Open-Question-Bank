    <questionvariables>
      <text><![CDATA[pm1:rand_with_prohib(-1,1,[0]);
aa:pm1*(rand(3)+1);
bb:rand(3)+1;
dfx:expand(3*(x-aa)*(x-bb));
dfxs: diff(dfx,x);
sol_dfxs: rhs(solve(dfxs)[1]);
pt1:aa;
pt2:bb;
x1:if pt1<pt2 then pt1 else pt2;
x2:if pt1>pt2 then pt1 else pt2;
dfx_x11:subst(x1,x,dfx);
dfx_x22:subst(x2,x,dfx);

bx1:ev(dfx,x=x1-0.1);
behbx1:if bx1<0 then "decreasing" else "increasing";
ax1:ev(dfx,x=x1+0.1);
behax1:if ax1<0 then "decreasing" else "increasing";
bx2:ev(dfx,x=x2-0.1);
behbx2:if bx2<0 then "decreasing" else "increasing"
ax2:ev(dfx,x=x2+0.1);
behax2:if ax2<0 then "decreasing" else "increasing"; 
classx1: if bx1<0 and ax1>0 then "minimum" elseif bx1<0 and ax1<0 then "inflection" elseif bx1>0 and ax1>0 then "inflection" else "maximum";
classx2: if bx2<0 and ax2>0 then "minimum" elseif bx2<0 and ax2<0 then "inflection" elseif bx2>0 and ax2>0 then "inflection" else "maximum";
pm3:rand_with_prohib(-1,1,[0]);
cc:pm3*(rand([1,3,5,7,9,11]));
fx:integrate(dfx,x)+cc;
tamaxx:if classx1 = "maximum" then x1 elseif classx2 = "maximum" then x2 else none;
tamaxy:if tamaxx = none then none else ev(fx,x=tamaxx);
taminx:if classx1 = "minimum" then x1 elseif classx2 = "minimum" then x2 else none;
taminy:if taminx = none then none else ev(fx,x=taminx);
tainfx: sol_dfxs;
tainfy: ev(fx,x=sol_dfxs);
tainc:if taminx=none then x<x1 or x>x1 else x<x1 or x>x2;
tadec:if taminx=none then none else x>x1 and x<x2;


simp:false;
dfx_x1:subst(x1,x,dfx);
dfx_x2:subst(x2,x,dfx);
]]></text>
    </questionvariables>
