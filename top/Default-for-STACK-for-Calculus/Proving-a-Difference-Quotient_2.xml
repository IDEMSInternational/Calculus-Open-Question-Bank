    <questionvariables>
      <text><![CDATA[/* Step 1: Calculate f(x+h) using f(x) */
constant:(rand(100)+5);
fx:constant^(x);
fxh:constant^((x)+h);
/* Step 2: Rewrite f(x+h) as a^x * b^h */
simp:false;
fxh_expand: factor(constant^(x)*constant^(h));
/* Step 3: Subtract f(x) from f(x+h) */
fx_lhs: fxh - fx;
fx_factored:factor(fx_lhs);
/* Step 4: Divide both sides by h and recognize the left side as the derivative of f(x) with respect to x */
fx_fact_h: (fx_factored/h);

/*Model Answers*/
ta1:fxh;

ta2:(constant^(x))*(constant^(h));

ta3:fx_factored;

corr_ans : [
    [1, true, sconcat("\\(\\displaystyle ", fx, "  \\left(\\frac{ ", constant, "^{h} - 1}{h} \\right )=\\frac{f(x+h)-f(x)}{h}\\)")]
];

incorr_ans : rand_selection([
    [2, false, sconcat("\\(\\displaystyle ", fx, "  \\left(\\frac{ ", constant, "^{h} - 1}{h} \\right ) \\neq \\frac{f(x+h)-f(x)}{h}\\)")],
    [3, false, sconcat("\\(\\displaystyle ", fx, "  \\left(\\frac{ ", constant, "^{h} - 1}{h} \\right ) \\geq \\frac{f(x+h)-f(x)}{h}\\)")],
    [4, false, sconcat("\\(\\displaystyle ", fx, "  \\left(\\frac{ ", constant, "^{h} - 1}{h} \\right ) > \\frac{f(x+h)-f(x)}{h}\\)")],
    [5, false, sconcat("\\(\\displaystyle ", fx, "   \\left(\\frac{ ", constant, "^{h} - 1}{h} \\right ) < \\frac{f(x+h)-f(x)}{h}\\)")]], 2);

ta4: random_permutation(append(corr_ans, incorr_ans));]]></text>
