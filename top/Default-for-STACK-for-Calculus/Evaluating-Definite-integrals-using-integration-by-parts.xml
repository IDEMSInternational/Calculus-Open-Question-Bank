    <questionvariables>
      <text>aa: 1+rand(4); bb: 2+aa; cc:rand(4);
func_var_u:rand([bb*cc+x*aa, aa+bb*x]); /*this is what will become  u in the question func*/
func_var_dv:e^(aa*x/bb);  /*varible for dv in the question func*/
question_func:(func_var_u)*(func_var_dv);     /* questoin expression in terms of u \times dv*/
lower_limit:rand(4);
upper_limit:1+rand(3)+lower_limit;


/*Model answers*/
model_ta:int(question_func,x,lower_limit,upper_limit);   /*force simplification of model answer*/
ta:ratsimp(model_ta);

/*Worked out solution codes*/
diff_u:diff(func_var_u)/del(x);    /* derivative of var_u */
int_v: int(func_var_dv,x);    /* integral of dv to get v */
v_du: int_v*diff_u;              /* porduct  (diff_u and int_v) */ 
int_v_du: int(v_du,x);         /* integral of _ porduct  (diff_u and int_v) */</text>
    </questionvariables>
