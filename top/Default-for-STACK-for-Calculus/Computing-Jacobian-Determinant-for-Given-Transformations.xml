    <questionvariables>
      <text>var1:rand_with_prohib(-3,3,[0]);  var2:rand_with_prohib(-3,3,[0]); var3:rand(3)+1;var4:rand(3)+1;
eq1: var1*u+var2*v^var3; /*eqn for x*/
aa:diff(eq1,u);
bb:diff(eq1,v);

eq2:var3*u^var4-var2*v; /*eqn for y*/
cc:diff(eq2,u);
dd:diff(eq2,v);
ta1:matrix([aa,bb],[cc,dd]); /*input 1- matrix input*/
ta2:determinant(ta1);   /*input 2- determinant of input 1*/</text>
    </questionvariables>
