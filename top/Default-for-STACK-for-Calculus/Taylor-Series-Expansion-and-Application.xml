    <questionvariables>
      <text>/*Defining question variables*/
coeff:rand(5)-6;
power:coeff*x;
xx:-1*(rand(5)+2);
fx:%e^(power);  /*the question*/

f1:diff(fx,x); f1x:ev(f1,x=xx);/*derivatives of f(x) up to the desired order*/
f2:diff(f1,x); f2x:ev(f2,x=xx);
f3:diff(f2,x); f3x:ev(f3,x=xx);
f4:diff(f3,x); f4x:ev(f4,x=xx);
general_term:coeff^n*%e^(coeff*xx);
taylor_series:sum((general_term/n!*(x-xx)^n),n,0,inf);

ta1:sum((general_term/n!*(x-xx)^n),n,0,3),simpsum:true; /*first 4 terms*/ /*Model answers*/
ta2:taylor_series;</text>
    </questionvariables>
