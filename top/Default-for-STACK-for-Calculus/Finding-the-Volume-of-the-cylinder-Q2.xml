    <questionvariables>
      <text>/*Defining the question variables*/ 
coef_x:rand(4)+1;/*coefficient of x in the function*/
f_x:1/(coef_x*x); /*the function*/
lower_limit:1/(rand(4)+1);
upper_limit:rand(4)+1;
area_x:2*%pi*(x)*f_x; /*The area of the cylinder*/
volume_x:int(area_x,x,lower_limit,upper_limit); /*The volume of the solid*/

/*Model answer*/
ta:volume_x;</text>
