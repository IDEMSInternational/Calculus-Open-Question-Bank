    <questionvariables>
      <text>p1:rand_with_step(-5,5,1);
p2:rand_with_prohib(-5,5,[p1]);
pwr1:rand_with_step(-90,90,3)/(rand(100)+3);
cf1:(p1*2);
cf2:(5*p2);
cf3:(p2*5);
cf4:(rand(10)+10);
expr:cf1*x^pwr1 +cf2*x^2 + cf3*x + cf4;
f(x) :=expr;  
ta1: subst(p1,x,expr);        /* Calculate f(4) */ 
ta2: diff(f(x), x); /* Calculate the derivative f'(x) */ 
ta3:subst(p2,x,ta2);         /* Calculate f'(0) */
ta4: diff(ta2, x); /* Calculate the derivative f''(x) */ </text>
    </questionvariables>
