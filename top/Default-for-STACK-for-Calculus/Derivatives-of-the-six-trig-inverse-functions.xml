    <questionvariables>
      <text>trig:rand([asin,acos,atan,acot,asec,acsc]);
coeff:rand_with_prohib(-5,5,[0]);
fx:trig(coeff*x);
diff_fx : diff(fx, x);
ta:diff_fx;</text>
