    <questionvariables>
      <text>/*Defining the question variables*/ 
coef1:rand(9)+1;/*coeffient of the function*/
const:rand(4)+1;/* constant inside the function*/
lower_x:rand(3)+1;/*lower lmit of x*/
upper_x:rand(4)+lower_x+2;/*upper lmit of x*/
functx:rand([coef1*x^(3/2),coef1*x^2,(const/coef1)*x^(3/2),(const/coef1)*x^2]);
d_functx: diff(functx,x);
ds: sqrt(1+d_functx^2);
lfx: int(ds,x);
lffx: int(ds,x,lower_x,upper_x);
ta1:decimalplaces(lffx,2);
</text>
