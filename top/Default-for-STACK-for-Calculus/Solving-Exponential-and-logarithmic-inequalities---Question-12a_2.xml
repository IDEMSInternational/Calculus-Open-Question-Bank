    <questionvariables>
      <text><![CDATA[/*exponential inequalities*/
rhs_const:rand_with_step(8,40,2);/*constant before the exponentail*/
lhs_const:rand_with_step(2,20,2)+2;/*constant after the inequality sign*/
power:rand(5)+5;
func:lhs_const*e^(power*x)< rhs_const;
/*worked soln variables*/
sol1:e^(power*x)<(rhs_const/lhs_const);
sol2:log(e^(power*x))<log((rhs_const/lhs_const));
sol3:x=log((rhs_const/lhs_const))/power;
sol4:float(rhs(sol3));
/*determining decimalplaces*/
round_dp_n(float_number, decimal_places) :=
  block(
    [rounded_number: floor(float_number * 10^decimal_places + 0.5)],
    float(rounded_number / 10^decimal_places)
  );
ta1:round_dp_n(sol4,2);
exact_form: rhs(sol3);
frac:rat(ta1);]]></text>
    </questionvariables>
