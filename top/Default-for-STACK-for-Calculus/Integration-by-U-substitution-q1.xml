    <questionvariables>
      <text>/*create random variables for the question*/
power_x:rand(4)+2;/*random value of the power*/
coeff_const:rand(9)+1 ;/*random value for the constant*/
aa:power_x-1;
bb:(x^power_x+coeff_const);
f_x:(x^(aa))*bb;  /*integral function*/

/*Model answers*/
ta_1:int(f_x,x)+c;

/*Worked out solution codes*/
diff_fx: diff(bb,x); 
var_xx:u*((x^aa))/diff_fx;
var_x1:int(var_xx,u)+c;</text>
    </questionvariables>
