    <questionvariables>
      <text><![CDATA[pm1:rand_with_prohib(-1,1,[0]);
aa:pm1*(rand([3,6,9,12]));
pm2:rand_with_prohib(-1,1,[0]);
bb:pm2*(rand_with_prohib(1,8,[abs(aa)]));
pm3:rand_with_prohib(-1,1,[0]);
cc:pm3*(rand_with_prohib(1,8,[abs(aa),abs(bb)]));
fx:x^3+aa*x^2+bb*x+cc;
dfx:diff(fx,x);
ddfx:diff(dfx,x);
tainfx:-aa/3;
tainfy:ev(fx,x=tainfx);
tacond:x<tainfx;
taconu:x>tainfx;]]></text>
    </questionvariables>
