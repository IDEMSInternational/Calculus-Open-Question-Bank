c2:rand_with_prohib(-290,290,[cf1,0,cf2,c1]);
var:rand([x,y,z,q,w,r,t,p]);
fx:cf1*var+c1; diff_fx:diff(fx,var);
gx:cf2*var+c2; diff_gx:diff(gx,var);
hx :fx / gx; diff_hx :factor(diff(hx, var));  
/*Models Answer*/
ta:diff_hx;</text>
