lower_lmt:-upper_lmt;
num:rand(4)+2;
func:num/v;
/*worked solution*/
sol1:int(func,v);
val1_upper:subst(v=t,sol1);
val1_lower:subst(v=lower_lmt,sol1);
ta1:-inf;
/*2nd integration*/
val2_upper:subst(v=upper_lmt,sol1);
val2_lower:subst(v=t,sol1);
ta2:inf;
ta_3:random_permutation([["Divergent", true],["Convergent", false],["Divergent and convergent", false]]);]]></text>
