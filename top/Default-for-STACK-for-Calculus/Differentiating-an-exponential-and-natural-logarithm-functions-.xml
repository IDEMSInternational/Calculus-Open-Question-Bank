    <questionvariables>
      <text>/* Define the function */
aa:rand(500);
pwr:rand_with_prohib(-100,5,[-1,0,1]);
bb:rand(500)+2;
nn:rand(3)+2;
dd:rand_with_prohib(1,6,[nn]);
w_val:nn/dd;
rw1:aa^w; 
diff_term1: diff(rw1, w);
rw2:pwr*log(w)/log(bb); 
diff_term2: diff(rw2, w);
rw : rw1+rw2 ;    
/* Combine the derivatives of the terms */
rw_diff:diff(rw, w); 
ta1:(rw_diff); 
sol:at(ta1,[w=w_val]);
ta2: decimalplaces(sol,2);
</text>
    </questionvariables>
