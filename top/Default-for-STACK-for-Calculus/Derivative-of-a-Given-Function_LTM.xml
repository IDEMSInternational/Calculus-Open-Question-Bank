pm3:rand_with_prohib(-1,1,[0]);
c3:pm3*(rand(6)+2);
pm4:rand_with_prohib(-1,1,[0]);
c4:pm4*(rand(6)+2);
fx:x^(p1)+c2*x^(p2)+c3*x^(p3)+c4*x^(p4);
ta:diff(fx,x);</text>
