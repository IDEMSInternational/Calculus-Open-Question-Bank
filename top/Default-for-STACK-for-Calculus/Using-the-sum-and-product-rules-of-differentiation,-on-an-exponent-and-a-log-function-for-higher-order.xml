    <questionvariables>
      <text>/* Define the function */
a1:3;
a2:1;
coefx:10;
pwr:3;
x_val:rand(2)+1;
fx1:a1*%e^(a2*x);
diff_fx1:diff(fx1,x);
fx2:coefx*x^pwr;
diff_fx2:diff(fx2,x);

trig:rand([log, sin,cos,tan,cot,sec,csc]);
fx3:trig(x);
diff_fx3:diff(fx3,x);
diff_fx4:diff(fx2*fx3,x);
fx : fx1+ fx2*fx3;  
/* Find the first derivative */ 
f_prime_x : diff(fx, x);  
/*Model answers*/
ta1:f_prime_x; 
ta2:diff(ta1, x);  
ta3:diff(ta2, x);  
sol:at(ta3,[x=x_val]); 
ta4: sol;</text>
    </questionvariables>
