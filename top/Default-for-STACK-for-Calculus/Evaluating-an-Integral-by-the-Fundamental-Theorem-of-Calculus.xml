quest_expr:coef_t*t^power-constant;
/*worked solution*/
soln1:int(quest_expr,t);
question_solution:int(quest_expr,t,lower_limit,upper_limit);
soln3:subst(upper_limit,t,soln1);
soln4:subst(lower_limit,t,soln1);
s5:soln4-soln3;
ta1:float(question_solution);</text>
