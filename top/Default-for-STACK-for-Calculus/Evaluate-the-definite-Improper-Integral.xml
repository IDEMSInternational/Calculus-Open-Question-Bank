    <questionvariables>
      <text><![CDATA[/*Question variable*/
lower_limit:rand(5)-7;
upper_limit:rand(5)-1;
num:rand(3)+1;
den_const:rand(10)+2;
coeff_z:rand(5)+1;
den:den_const+coeff_z*z;
den_diff:diff(den,z);
func:num/(den);

/*Worked solution*/
var_z:-(den_const)/coeff_z;




/*Model answer*/
ta_a:int(func,z);
ta_b:subst(z=t,ta_a);
ta_c:subst(z=upper_limit,ta_a);
ta_d:ta_c-ta_b;
ta_e:limit(ta_b,t,lower_limit,plus);
ta_1:limit(ta_d,t,var_z,plus);
ta_2:if ta_1=minf then "Divergent" elseif ta_1=inf then "Divergent" else"Convergent";
ta_3:if ta_2="Divergent" then "Convergent" else "Divergent";
ta_4:random_permutation([[ta_2, true],[ta_3, false],["Divergent and convergent", false]]);]]></text>
    </questionvariables>
