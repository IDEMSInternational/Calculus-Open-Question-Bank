    <questionvariables>
      <text>/*Random generating and calculating variables*/
aa:rand(5)+1;
bb:rand_with_prohib(-8,8,[0,1]);
tt:rand([t,x,z]);
power:rand(8)+9;
func:(aa+bb*tt)^power;
func_u:(1/bb)*((u)^power);

/*substitution expressions*/
us: aa+bb*tt;
ss: int(u^power,du)
ss:(u^(power+1))/(power+1)+c;

ta_1:int(func,tt)+c;

/*Worked solution*/
tas:int(func_u,u)+c;</text>
