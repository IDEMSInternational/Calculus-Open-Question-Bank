    <questionvariables>
      <text> /* Define the equation */
power1:rand([rand_with_step(2,10,2),(rand(10)+1)/(rand(10)+2)]);
power2:power1*2;
c1:rand(10)+1;
c2:rand(10)+1;
fx:c1*x^power1;
fy:c2*y^power2;
const:rand(100)+10;
eq: fx + fy = const; 
/* Differentiate both sides with respect to x */ 
dfx: diff(fx, x);
dfy: diff(fy, y);
dfc: diff(const, x);
func:dfy*(dz)=-dfx;
ta:rhs(solve(func,dz)[1]);
</text>
