    <questionvariables>
      <text>aa: 1+rand(4); bb: 2+aa;
func_var_u:rand([bb*x^aa, aa+bb*x]); /*this is what will become  u in the question func*/
func_var_dv:cos(aa*bb-aa*x);  /*varible for dv in the question func*/
question_func:(func_var_u)*(func_var_dv);     /* questoin expression in terms of u \times dv*/

/*Worked out solution codes*/
diff_u:diff(func_var_u)/del(x);    /* derivative of var_u */
int_v: trigreduce(int(func_var_dv,x));    /* integral of dv to get v */
v_du: int_v*diff_u;              /* product  (diff_u and int_v) */ 
int_v_du: ratsimp(int(v_du,x));         /* integral of _ product  (diff_u and int_v) */
Sol1:func_var_u*func_var_dv;

/*model answers*/
ta1a:func_var_u;
ta1b:func_var_dv;
ta1c:int_v;
ta1d: ta1a*ta1c;
ta1e:int_v_du;
ta_1:expand(int(question_func,x));   /*force simplification of model answer*/
ta:trigreduce(ta_1)+c;

</text>
    </questionvariables>
