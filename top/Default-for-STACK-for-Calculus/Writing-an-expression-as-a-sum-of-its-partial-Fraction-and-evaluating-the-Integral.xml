    <questionvariables>
      <text>/*Random variables for the question*/
aa:1+rand(5); /*constant in the first partial fraction*/
bb:rand_with_prohib(1,6,[aa]);/*constant in the second  partial fraction*/
zz:rand_with_prohib(-7,7,[0]);/* numerator*/
question:zz/((x+aa)*(x-bb));
question_expression:zz/expand((x+aa)*(x-bb));
part_frac_1:A/(x+aa);
part_frac_2:B/(x-bb);
part_frac:part_frac_1+part_frac_2;
/*Worked out solution codes part a */
numerator_question_expression:num(question_expression);
expr:A*(x-bb)+B*(x+aa)=numerator_question_expression;
expr1:ev(expr,x=bb);
expB:expr1/ev((x+aa),x=bb);
expr2:ev(expr,x=-aa);
expA:expr2/ev((x-bb),x=-aa);
val_B:ev(numerator_question_expression,x=bb)/ev(x+aa,x=bb);
val_A:ev(numerator_question_expression,x=-aa)/ev(x-bb,x=-aa);

ta_1:val_A/(x+aa);
ta_2:val_B/(x-bb);
ta_sum: ta_1+ta_2
expr3: question_expression=ta_1+ta_2;

/*model answer part b*/
int_part1:int(ta_1,x);
int_part2:int(ta_2,x);
ta_3:int_part1+int_part2+c;</text>
    </questionvariables>
