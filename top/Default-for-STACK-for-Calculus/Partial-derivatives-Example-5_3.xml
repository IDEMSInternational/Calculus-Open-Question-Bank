    <questionvariables>
      <text>/*Defining randomised coefficients*/
aa: rand_with_prohib(-9,9,[0]);
bb:  rand_with_prohib(-5,5,[0]);
cc:  rand_with_prohib(-7,7,[0]);
dd:  rand_with_prohib(-8,8,[0]);
nn: rand(5)+1;
mm: rand(3)+1;
ee: rand(4)+1;
/*Define the function p(y1, y2, y3)*/
pp: (aa*y1^nn*y2^mm*y3^ee)/(bb*y1+cc*y2+dd*y3);

/*Define the coordinates of the randomised point */
xx: rand_with_prohib(-3,4,[0]);  /*representing the value for y1*/
yy: rand_with_prohib(-2,3,[0]); /*representing the value for y2*/
zz:  rand_with_prohib(-5,5,[0]); /*representing the value for y3*/

/*Model answers*/
ta_1: (diff(aa*y1^nn*y2^mm*y3^ee,y3)*(bb*y1+cc*y2+dd*y3)-diff(bb*y1+cc*y2+dd*y3,y3)*(aa*y1^nn*y2^mm*y3^ee))/((bb*y1+cc*y2+dd*y3)^2);
ta_2: at(ta_1, [y1=xx, y2=yy, y3=zz]);</text>
    </questionvariables>
