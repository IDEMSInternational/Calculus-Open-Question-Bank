    <questionvariables>
      <text>/*compound interest question*/
principal:rand_with_step(6000,10000,500);
rate:rand(5)+5;
rate_float:float(rate/100);
years:rand(20)+20;
/*worked solution variables*/
sol1:(1+(rate_float/2))^(2*years);
sol2:principal*sol1;
round_dp_n(float_number, decimal_places) :=
  block(
    [rounded_number: floor(float_number * 10^decimal_places + 0.5)],
    float(rounded_number / 10^decimal_places)
  );
ta1:round_dp_n(sol2,2);</text>
    </questionvariables>
