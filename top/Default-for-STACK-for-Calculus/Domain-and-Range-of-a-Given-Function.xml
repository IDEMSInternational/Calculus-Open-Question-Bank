    <questionvariables>
      <text>aa:rand(8)+1;
pm1:rand_with_prohib(-1,1,[0]);
bb:rand(8)+1;
pm2:rand_with_prohib(-1,1,[0]);
cc:rand(8)+1;
fx:expand((x-pm1*aa)*(x-pm2*bb)+cc);
xv:(pm1*aa+pm2*bb)/2;
yv:ev(fx,x=xv);
ta1:oo(-inf,inf);
ta2:co(yv,inf);
/*Worked solution*/
val_b_2a: (-(pm1*aa + pm2*bb))/2;
eval_discr: -val_b_2a^2+(pm1*aa*pm2*bb) + cc;
</text>
    </questionvariables>
