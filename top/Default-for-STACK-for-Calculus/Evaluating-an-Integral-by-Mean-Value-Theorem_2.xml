    <questionvariables>
      <text>/*Question variables*/
constant:rand(5)+5;
coeff_2:rand(4)+2;
quest_expr:constant-coeff_2*x;
value_a:0;
value_b:rand(5)+1;

func_1:int(quest_expr,x);
func_2:int(quest_expr,x,value_a,value_b);
ta1:ratsimp(((1/value_b)*func_2));
func_3:subst(c,x,quest_expr);
ta2:rhs(solve(func_3=ta1)[1]);
</text>
