    <questionvariables>
      <text>/*Define the function*/
coef:rand(100)+1;
power:rand(5)+2;
f(x):=coef*x^power; 

/*Worked Solution code*/
difference_quotient: (f(x + h) - f(x)) / h;
difference_quotient_expand:expand(num(difference_quotient));
difference_quotient_factor:factor(difference_quotient_expand);
simplified_quotient:difference_quotient_factor/h;
derivative_from_diff_quotient: limit(simplified_quotient, h, 0); 

/*Model answer*/
ta:diff(f(x),x);
</text>
