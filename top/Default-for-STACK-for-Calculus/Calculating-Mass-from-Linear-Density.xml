    <questionvariables>
      <text>/* Define the function */  
trig:rand([sin,cos]); 
rho_x: trig(x); 
even_numbers: makelist(2 * i, i, 1, 16);
num:rand_with_step(2,16,2);
den:rand(even_numbers);  
a : (%pi*den)/num; 
b:rand([a+%pi, a+%pi/2, a+%pi*(3/2), a+%pi*(1/4), a+%pi*(3/4), a+%pi*(2/3), a+%pi*(1/3)]);
mass : int(rho_x, x, a, b); 
</text>
