    <questionvariables>
      <text>aa:rand([1,2]);
trig1:if aa=1 then cos else sin;
trig2:if trig1=cos then sin else cos;
coeff:rand_with_prohib(-4,4,[-1,0]);
c1:rand(3);
c2:rand_with_prohib(-3,3,[0]);

ut:trig1(coeff*t); 
du:diff(ut,t);

vt:c1 - c2*trig2(coeff*t);
dv:diff(vt,t);
duv:(du*vt-ut*dv)/vt^2;
dsimolified:simplify(du*vt-ut*dv)/vt^2;
pt: ut/vt; 
dpt : diff(pt, t); 
ta : trigsimp(dpt); </text>
    </questionvariables>
