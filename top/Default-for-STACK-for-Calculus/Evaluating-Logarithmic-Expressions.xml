      <text>random_num1:rand_with_step(10,90,1);
random_num2:rand_with_prohib(2,15,[10]);
random_num3:rand_with_prohib(2,15,[10,random_num2]);
ta1:decimalplaces(float(log(random_num1)/log(random_num2)),6);
random_num: rand(89) + 11; /*This generates a random number between 0 and 89 and then adds 11 to ensure the number falls between 11 and 99*/
while (mod(random_num, 10) = 0) do
    random_num: rand(89) + 11; /*This loop checks if the generated number is a multiple of 10. If it is, it generates a new random number until one is obtained that isn't a multiple of 10*/
random_num;
ta2:decimalplaces(float(log(random_num/10)/log(random_num3)),6);
</text>
