    <questionvariables>
      <text>/*Question variables*/
aa:rand_with_prohib(-5,5,[0]);
bb:rand_with_prohib(-5,5,[0]);
cc:rand_with_prohib(-5,5,[0]);
dd:rand_with_prohib(-5,5,[0]);
ee:rand_with_prohib(-5,5,[0]);

/*Question func*/
func_w:sqrt(x^aa+y^aa)+bb*z/y;
func_x:sin(cc*p);
func_y:bb*p+dd*t-ee*s;
func_z:t^dd/(s^aa);
func_p:bb-aa*t;


/*Worked Soln variables*/
diff_wx:diff(func_w,x);diff_xp:diff(func_x,p);diff_pt:diff(func_p,t);
diff_wy:diff(func_w,y); diff_yp:diff(func_y,p);
diff_wz:diff(func_w,z);diff_yt:diff(func_y,t);
diff_zt:diff(func_z,t);
diff_ys:diff(func_y,s);
diff_zs:diff(func_z,s);


ta1:diff_wx*diff_xp*diff_pt+ diff_wy*diff_yp*diff_wy+ diff_wy*diff_yt+ diff_wz*diff_zt;

ta2:diff_wy*diff_ys+diff_wz*diff_zs;</text>
    </questionvariables>
