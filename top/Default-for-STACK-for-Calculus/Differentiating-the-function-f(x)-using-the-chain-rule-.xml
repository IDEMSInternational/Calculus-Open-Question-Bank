u:cfx*x^power + cf2*x; diff_u:diff(u,x);
fx:sin(u); diff_f:cos(u);
/* Differentiate the function with respect to x */ 
dfx : diff(fx, x);  
/* Simplify the result if needed */ 
ta:simplify(dfx);</text>
