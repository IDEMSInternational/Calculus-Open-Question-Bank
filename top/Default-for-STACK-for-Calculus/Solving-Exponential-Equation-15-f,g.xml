  <question type="stack">
    <name>
      <text>Solving Exponential Equation 15 f,g</text>
    </name>
    <questiontext format="moodle_auto_format">
      <text><![CDATA[<p>Find the value of  \(x\) in the equation \(\displaystyle {@eqn@}\)</p>
<p><b>Note</b>: Give your answer to \(2\) decimal places.</p>
<p>\(x= \) [[input:ans1]] [[validation:ans1]]</p>
<p>[[feedback:prt1]]</p>]]></text>
    </questiontext>
    <generalfeedback format="moodle_auto_format">
      <text><![CDATA[<h3> Worked solution</h3>
<p>
[[ if test='eqn=eqn_1 ' ]] 
<br>\(\displaystyle {@eqn@} \implies x=\ln {@const_1@} ={@ta_1@}\)

[[ else ]]
<br>\(\displaystyle {@eqn@} \implies e^{x} =\ln {@const_2@}\)
<br> \(\qquad \qquad \implies x=\ln (\ln {@const_2@} )={@ta_1@}\)
[[/ if]]
</p>]]></text>
    </generalfeedback>
