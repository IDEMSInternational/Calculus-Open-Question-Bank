    <questionvariables>
      <text>var_1:rand(3)+2;
var_2:rand_with_step(1,10,2);
const_1:rand(5)+var_1;/*constant of the equation*/
const_2:rand_with_prohib(1,7,[var_1,var_2,const_1]);
eqn_1:e^x=const_1;
eqn_2:e^(e^(x))=const_2;
eqn:rand([eqn_1,eqn_2]);
ta:rhs(solve(eqn,x)[1]);

ta_1:decimalplaces(rhs(solve(eqn,x)[1]),2);
</text>
