    <questionvariables>
      <text><![CDATA[aa:rand([3,6,9,12]);
bb:rand([5,10,15]);
pm3:rand_with_prohib(-1,1,[0]);
cc:pm3*(rand(15)+1);
fx:-aa*x^5+bb*x^3+cc;
dfx:diff(fx,x);
x2:0;
x3:((3*bb)/(5*aa))^0.5;
x1:-((3*bb)/(5*aa))^0.5;
bx1:ev(dfx,x=x1-0.1);
ax1: ev(dfx,x=x1+0.1);
bx2:ev(dfx,x=x2-0.1);
ax2:ev(dfx,x=x2+0.1);
bx3:ev(dfx,x=x3-0.1);
ax3:ev(dfx,x=x3+0.1);
behbx1:if bx1<0 then "decreasing" else "increasing";
behax1:if ax1<0 then "decreasing" else "increasing";
behbx2:if bx2<0 then "decreasing" else "increasing";
behax2:if ax2<0 then "decreasing" else "increasing";
behbx3:if bx3<0 then "decreasing" else "increasing"
behax3:if ax3<0 then "decreasing" else "increasing"  
classx1: if bx1<0 and ax1>0 then "minimum" elseif bx1<0 and ax1<0 then "inflection" elseif bx1>0 and ax1>0 then "inflection" else "maximum";
classx2: if ev(dfx,x=x2-0.1)<0 and ev(dfx,x=x2+0.1)>0 then "minimum" elseif ev(dfx,x=x2-0.1)<0 and ev(dfx,x=x2+0.1)<0 then "inflection" elseif ev(dfx,x=x2-0.1)>0 and ev(dfx,x=x2+0.1)>0 then "inflection" else "maximum";
classx3: if bx3<0 and ax3>0 then "minimum" elseif bx3<0 and ax3<0 then "inflection" elseif bx3>0 and ax3>0 then "inflection" else "maximum";
tamaxx:if classx1 = "maximum" then x1 elseif classx2 = "maximum" then x2 elseif classx3 = "maximum" then x3 else none;
tamaxy:if tamaxx = none then none else ev(fx,x=tamaxx);
taminx:if classx1 = "minimum" then x1 elseif classx2 = "minimum" then x2 elseif classx3 = "minimum" then x3 else none;
taminy:if taminx = none then none else ev(fx,x=taminx);
tainfx:if classx1 = "inflection" then x1 elseif classx2 = "inflection" then x2 elseif classx3 = "inflection" then x3 else none;
tainfy:if tainfx = none then none else ev(fx,x=tainfx);]]></text>
    </questionvariables>
