    <questionvariables>
      <text>/*Defining the question*/
point_x:rand(5)+1; point_y:rand(3)-5; point_z:rand(5)+5;
constant:rand(5)+30;
question_expr: x^2+y^2+z^2=constant;
/*Worked solution*/
function:F(x,y,z)=x^2+y^2+z^2;
gradient_x:diff(rhs(function),x);
gradient_y:diff(rhs(function),y);
gradient_z:diff(rhs(function),z);
gradient_F:[gradient_x,gradient_y,gradient_z];
gradient_Fxyz:[gradient_x*point_x/x,gradient_y*point_y/y,gradient_z*point_z/z];
tangent:gradient_Fxyz[1]*(x-point_x)+gradient_Fxyz[2]*(y-point_y)+gradient_Fxyz[3]*(z-point_z);
normal:[point_x+gradient_Fxyz[1]*t,point_y+gradient_Fxyz[2]*t,point_z+gradient_Fxyz[3]*t];
/*Model answers*/
ta_1:gradient_x;
ta_2:gradient_y;
ta_3:gradient_z;
ta_4:gradient_Fxyz[1];
ta_5:gradient_Fxyz[2];
ta_6:gradient_Fxyz[3];
ta_7:tangent;
ta_8:normal;</text>
    </questionvariables>
