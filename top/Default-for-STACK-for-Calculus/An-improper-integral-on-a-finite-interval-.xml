    <questionvariables>
      <text><![CDATA[/* Define the integrand */
num:rand(9)+9;
coeff_x:x;
aa:rand(6)+4;
coeff_sqr:x*(aa*sqrt(x));
func:num/(coeff_x*coeff_sqr);
lower_lmt:0;
upper_lmt:rand(3)+3;
/* Step 1: Compute the antiderivative */
antiderivative:int(func, x);
/* Step 2: Set up the integral with limits from epsilon to 3 */
upper_limit : subst(x=upper_lmt, antiderivative);
lower_limit : subst(x=epsilon, antiderivative);

/* Step 3: Define the improper integral using the limit */
ta1: limit(upper_limit - lower_limit, epsilon, 0, plus);
/*Model answers*/
ta2:if ta1=inf then "Divergent" elseif ta1=minf then "Divergent" else"Convergent";
ta3:if ta_2="Divergent" then "Convergent" else "Divergent";
ta_4:random_permutation([[ta2, true],[ta3, false],["Divergent and convergent", false]]);]]></text>
