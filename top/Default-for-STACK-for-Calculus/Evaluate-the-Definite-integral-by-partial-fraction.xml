    <questionvariables>
      <text>/*Random variables for the question*/
aa:rand(5); /*constant in the first part of the partial fraction*/
bb:rand_with_prohib(1,5,[aa]);/*constant in the second part of the partial fraction*/
cc:rand_with_prohib(1,5,[aa,bb]);/*constant in the second part of the partial fraction*/
zz_1:rand_with_prohib(1,6,[0]);/* numerator_1*/
zz_2:rand_with_prohib(1,6,[0,zz_1]);/* numerator_2*/
zz_3:rand_with_prohib(1,6,[0,zz_1,zz_2]);/* numerator_3*/
part_frac_1:zz_1/(x+aa);/*part one of the partial fraction*/
part_frac_2:zz_2/(x+bb);/*part two of the partial fraction*/
part_frac_3:zz_3/(x+cc);/*part three of the partial fraction*/
question_expression: factor(part_frac_1+part_frac_2+part_frac_3);
lower_limit:rand_with_step(1,4,1);
upper_limit:rand_with_step(5,9,1);

/*model answer*/
ta1:part_frac_1;
ta2:part_frac_2;
ta3:part_frac_3;
ta4:ta1+ta2+ta3;


/*Worked out solution codes */
part_frac_A:A/(x+aa);
part_frac_B:B/(x+bb);
part_frac_C:C/(x+cc);
numerator_question_expression:num(question_expression);
expr:A*(x+bb)*(x+cc)+B*(x+aa)*(x+cc)+C*(x+aa)*(x+bb)=numerator_question_expression;
expr1:ev(expr,x=-bb);
expB:expr1/ev((x+aa)*(x+cc),x=-bb);
expr2:ev(expr,x=-aa);
expA:expr2/ev((x+bb)*(x+cc),x=-aa);
expr3:ev(expr,x=-cc);
expC:expr3/ev((x+aa)*(x+bb),x=-cc);

expr4: question_expression=ta1+ta2+ta3;
int_ta1:int(ta1,x,lower_limit,upper_limit);
int_ta2:int(ta2,x,lower_limit,upper_limit);
int_ta3:int(ta3,x,lower_limit,upper_limit);
ta:int(question_expression,x,lower_limit,upper_limit);</text>
    </questionvariables>
