    <questionvariables>
      <text>aa: 4+rand(7);
bb: max(2, aa-2) + rand(aa - max(2, aa-2));

coef_xy:rand(5)+2;
constant:rand(7)+7;
radius:rand(5)+1;
func_1:coef_xy*xy+constant;
func_2:x^2+y^2=radius^2;
theta_1:0;
theta_2:(1/2)*pi;
r_1:0;
r_2:radius;
dA:r*dr*dtheta;
x:r*cos(theta);
y:r*sin(theta);
expr:coef_xy*x*y+constant;
eqn_1:r*coef_xy*(r *cos(theta))*(r *sin(theta))+constant*r;
eqn_2:integrate (eqn_1, r, r_1, r_2); /*Here is the r integration.*/
eqn_3:integrate (eqn_2, theta, theta_1,theta_2); /*Here is the theta integration.*/

ta6:eqn_3;

/*possible mistakes*/
mistake_4:radius;</text>
