    <questionvariables>
      <text><![CDATA[/*Defining question Variables*/
a:(rand(8)+1)^2;
b:(rand_with_prohib(1, 3, [a]))^2;
c:rand(5)+1;
p_sq:(rand(6)+1)^2;
d:p_sq*b;
e:rand(20)+1;
f_xy:a*x^2+c*y^2+e;
g_xy:b*x^2+c*y^2=d;
g_xy_di:b*x^2+c*y^2;
lar_xl:-sqrt(d/b);
lar_xr:sqrt(d/b)
lar_yl:-sqrt(d/c);
lar_yr:sqrt(d/c);
d1:diff(f_xy,x);
d2:diff(g_xy_di,x);
d3:diff(f_xy,y);
d4:diff(g_xy_di,y);
f_x:diff(f_xy,x)=diff(g_xy_di,x)*lambda;
f_y:diff(f_xy,y)=diff(g_xy_di,y)*lambda;
f_const:g_xy;
val_x1:subst(lar_xl,x,f_xy);
val_x1y:subst(0,y,val_x1);
val_x2:subst(lar_xr,x,f_xy);
val_x2y:subst(0,y,val_x2);
val_y1:subst(lar_yl,y,f_xy);
val_y1x:subst(0,x,val_y1);
val_y2:subst(lar_yr,y,f_xy);
val_y2x:subst(0,x,val_y2);

/*Model answers*/
ta1:random_permutation([["compact", true],["not compact", false],["finite", false],["open", false]]);
ta2:random_permutation([[" has absolute extrema ", true],[" does not have absolute extrema ", false],["does not have local extrema", false]]);
ta3:f_x;
ta4:f_y;
ta5:f_const;
ta6:0;
ta7:1;
ta8:lar_xr;
ta9:matrix([lar_xl],[0]);
ta10:matrix([lar_xr],[0]);
ta11:0;
ta12:lar_yr;
ta13:matrix([0],[lar_yl]);
ta14:matrix([0],[lar_yr]);
ta15:max(val_x1y,val_x2y,val_y1x,val_y2x);
ta16:min(val_x1y,val_x2y,val_y1x,val_y2x);]]></text>
