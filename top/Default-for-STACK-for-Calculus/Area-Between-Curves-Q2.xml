    <questionvariables>
      <text>/*Defining the question variables*/ 
const1:rand(5)+8; /*constant in the first function*/
const2:rand(5)-8; /*constant in the second function*/
expr1:x=const1+y^2; /*first function*/
expr2:x=const2-y^2; /*second function*/
expr1_1:rhs(x=const1+y^2); /*first function*/
expr2_1:rhs(x=const2-y^2); /*second function*/
y_1:rand(5)-8; /*lower limit*/
y_2:rand(5)+8; /*upper limit*/
x_1:rhs(ev(expr1,x,y=y_1)); /*min value of x*/
x_2:rhs(ev(expr2,x,y=y_2)); /*max value of x*/
area:rhs(expr1)-rhs(expr2); 
area_func:int(area,y);



/*Model answer*/
ta:int(area,y,y_1,y_2);</text>
