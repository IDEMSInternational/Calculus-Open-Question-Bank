    <questionvariables>
      <text>const_1:rand(6)+1;/*constant in the first equation*/
eqn_1:y^2-const_1;/*the first equation*/
const_2:rand(6)+1;/*constant in the second equation*/
coeff_y:rand(4)+1;/*coefficient of y*/
eqn_2:const_2-coeff_y*y;/*the second equation*/
eqn:eqn_1=eqn_2;/*equating the two equations*/
eqn_3: ratsimp(eqn_1-eqn_2);
eqn_4: factor(eqn_3);
solve: solve(eqn_3);/*solving for the equation*/
line_x1: 0;
line_x2: 21;
min_1:first(solve);/*the minimum value of the solution*/
min:rhs(min_1);/*the real part of the minimum value of the solution*/
max_1:second(solve);/*the maximum value of the solution*/
max:rhs(max_1);/*the real part of the minimum value of the solution*/
line_x:rand(8)-9;/*the value of the equation of the line in x-axis*/
line:y=line_x;/*equation of the line in x-axis*/
Radius:-line_x+y;/*the radius of the cylinder*/
Width: ratsimp(eqn_1-eqn_2);/*the width of the cylinder*/
Area_y:2*%pi*Radius*Width;/*the area of the cylinder*/
Area_y_1:expand(Radius*Width);
Area_y_2:2*%pi*Area_y_1;
Vol_1:int(Area_y_2,y);
Vol:int(Area_y_2,y,min,max);/*the volume of the cylinder*/
ta: abs(ratsimp(Vol));</text>
    </questionvariables>
