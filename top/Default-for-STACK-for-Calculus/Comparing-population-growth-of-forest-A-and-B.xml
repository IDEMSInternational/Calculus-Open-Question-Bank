    <questionvariables>
      <text><![CDATA[/* Part (a) */
powera:rand(0.10)+2;
powerb:rand_with_prohib(0.1,0.5,[powera]);
basea: rand_with_step(1001, 2005, 1) / 1000;
baseb:  rand_with_step(2006, 3001, 1) / 1000;
baseA: decimalplaces(basea^powera,3);
baseB: decimalplaces(baseb^powerb,3);
effective_growth: if baseA > baseB then "\\(\\text{Forest A is growing at a faster rate}\\)"
else "\\(\\text{Forest B is growing at a faster rate}\\)";
effective_growth_rate: if effective_growth="\\(\\text{Forest A is growing at a faster rate}\\)" then "\\(\\text{Forest B is growing at a faster rate}\\)" else "\\(\\text{Forest A is growing at a faster rate}\\)";

correct_answer:[[1, true, effective_growth]];
incorrect_answers:[[2, false, effective_growth_rate],
[3, false, "\\(\\text{None of the Forest  is growing at a faster rate}\\)"]];
ta1:random_permutation(append(correct_answer,incorrect_answers));
ta_index: sort(makelist(x[1], x, ta1));


/* Part (b) */
initial_A: rand_with_step(50,200,5);
initial_A_t:initial_A*baseA^0;
initial_B: rand_with_prohib(50,200,[initial_A]);
initial_B_t:initial_B*baseB^0;
initial_difference: abs(initial_A - initial_B);
initial_difference1:initial_difference+1;
initial_difference2:initial_difference+3;
initial_trees: if initial_A_t > initial_B_t then  sconcat("\\( \\text{Forest A had}\\, ",initial_difference," \\, \\text{more trees initially than Forest B} \\)")
else
sconcat("\\( \\text{Forest B had}\\, ",initial_difference,"  \\, \\text{more trees initially than Forest A} \\)");

/* correct answer */
corr_ans:[[1, true, initial_trees]];
/* wrong answers */
incorr_ans:[
[2, false, sconcat("\\( \\text{Forest A had}\\, ",initial_difference1," \\,  \\text{more trees initially than Forest B} \\)")],
[3, false, sconcat("\\( \\text{Forest B had} \\, ",initial_difference2," \\, \\text{more trees initially than Forest A} \\)")]];
ta2: random_permutation(append(corr_ans, incorr_ans));
/*Worked Soln*/
ta_index2: sort(makelist(x[1], x, ta2));



/* Part (c) */
years: rand(5)+2;
population_A_y: round(initial_A * (baseA^(years)));
population_B_y: round(initial_B * (baseB^(years)));
difference_y: abs(population_A_y - population_B_y);
years_growth: if population_A_y > population_B_y then "\\(\\text{Forest A}\\)" else "\\(\\text{Forest B}\\)";
years_growth_rate:if years_growth="\\(\\text{Forest A}\\)" then "\\(\\text{Forest B}\\)" else "\\(\\text{Forest A}\\)";


/* correct answer */
corr_sol:[[1, true, years_growth]];
/* wrong answers */
incorr_sol:[[2, false, years_growth_rate],
[3, false, "\\(\\text{None of the Forest}\\)"]];
ta3: random_permutation(append(corr_sol, incorr_sol));
/*Worked Soln*/
ta_index3: sort(makelist(x[1], x, ta3));]]></text>
