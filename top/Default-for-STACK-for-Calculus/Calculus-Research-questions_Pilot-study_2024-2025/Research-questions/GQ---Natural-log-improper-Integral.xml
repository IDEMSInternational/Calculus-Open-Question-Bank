    <questionvariables>
      <text><![CDATA[/*new improper questions*/
coeff1: rand(9)+1;
coeff2:rand(9)+1;
const1:0;
lower_limit:const1;
upper_limit:rand(5)+1+lower_limit;
fx:(coeff1*x)*log(coeff2*x);

	
/*worked out solution variables*/
expr_u:log(coeff2*x-const1*coeff2);
expr_du:diff(expr_u,x);
expr_dv:(coeff1*x);
expr_v:int(expr_dv,x);
expr_udv: expr_u*expr_dv;
expr_uv: expr_u*expr_v;
expr_vdu: expr_du*expr_v;
antider_fx: int(fx,x);
expr_inta: ev(expr_uv, x=upper_limit)-ev(expr_uv, x=t), simp;
expr_intb: int(expr_vdu,x,t,upper_limit);
expr_int_t: expand(expr_inta-expr_intb), simp;
int_fx: int(fx,x, lower_limit, upper_limit);

ta_1a:random_permutation([["The limits of integration include infinity", false],["The limits of integration contain a point of discontinuity", true],["The integrand is not continuous at a point in the interval of integration", true],["The integrand is not defined a point in the interval of integration", true]]);

ta_1b: expr_u;
ta_1c: expr_du;
ta_1d: expr_dv;
ta_1e: expr_v;
ta_1f: expr_uv;
ta_1g: expr_vdu;
ta_1h: antider_fx;
ta_1i: expr_int_t;

ta: limit(expr_int_t, t, const1);
ta1: simplify(ta);
ta2: random_permutation([["converges", true],["diverges", false],["converges and diverges", false]]);]]></text>
