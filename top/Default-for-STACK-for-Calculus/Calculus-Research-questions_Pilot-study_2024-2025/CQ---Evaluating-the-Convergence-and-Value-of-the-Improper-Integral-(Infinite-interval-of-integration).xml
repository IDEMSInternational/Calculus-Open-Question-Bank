    <questionvariables>
      <text><![CDATA[/* Define the constants and variables */
num:rand(10)+1;
denom_const:rand(4)+4;
coeff: rand(10)+1;
power:rand(5)+2/(rand(4)+2);
upper_limit:inf;
lower_limit:rand(5)+1;
point_disc:t;
den:(coeff*x+denom_const)^power;
fx : num/den;
int_fx: int(fx, x, lower_limit, upper_limit);

/*worked solution*/
expr_1: coeff*x+denom_const;
diff_u: diff(expr_1,x);
func_1: fx*(1/diff_u);
func_2: subst(u,expr_1,func_1);
expr_2:subst(t,x,expr_1);
expr_3:ev(expr_2,t=lower_limit);
func_3: int(func_2,u);
int_fu: func_3;

lower_limit_u: ev(expr_1,x=lower_limit);
upper_limit_u: ev(expr_1,x=t);
func_4: ev(func_3,u=upper_limit_u)-ev(func_3,u=lower_limit_u);
func_5: ratsimp(func_4);


/*Model answers*/
ta_1a:random_permutation([["The limits of integration are unbounded (include infinity)", true],["The limits of integration contain a point of discontinuity", false],["The integrand is not bounded (not continuous at a point) in the interval of integration", false]]);

ta_1b: expr_1;
ta_1c: diff_u;
ta_1d: func_2;
ta_1e: lower_limit_u;
ta_1f: upper_limit_u;
ta_1g: func_3;
ta_1h: func_5;

ta_1: int_fx;
ta_2:if ta_1=inf then "Divergent" elseif ta_1=minf then "Divergent" else"Convergent";
ta_3:if ta_2="Divergent" then "Convergent" else "Divergent";
ta_4:random_permutation([[ta_2, true],[ta_3, false],["Divergent and convergent", false]]);]]></text>
