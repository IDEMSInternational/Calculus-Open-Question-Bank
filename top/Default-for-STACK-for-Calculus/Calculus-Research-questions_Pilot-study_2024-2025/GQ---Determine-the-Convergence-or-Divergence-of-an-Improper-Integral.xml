    <questionvariables>
      <text><![CDATA[/* Step 1: Define the integrand */
lower_limit: 0;
upper_limit: rand(10)+3;
num: upper_limit+rand(3)+1;
den1:x^(rand(3)+1)
den2:sqrt(x);
den: den1*den2;
fx: num / den;  /* The function */
func: fx;

/* Step 2: Set up the improper integral using a limit as t -> 0+ */
int_func: int(func,x);
upper:at(int_func,x=upper_limit);
lower:at(int_func,x=t);
indef_val: upper-lower;

/*Model answers*/
ta_1a:random_permutation([["The limits of integration include infinity", false],["The limits of integration contain a point of discontinuity", true],["The integrand is not continuous at a point in the interval of integration", true],["The integrand is not defined a point in the interval of integration", true]]);
ta_1b: func;
ta_1c: int_func;
ta_1d: indef_val;

/* Model answer */
ta_1: limit(indef_val, t, lower_limit, plus);   /* Evaluate the limit as t approaches 0+ */
ta_2: if ta_1 = inf then "Divergent" elseif ta_1 = minf then "Divergent" else "Convergent";
ta_3: if ta_2 = "Divergent" then "Convergent" else "Divergent";
ta_4: random_permutation([[ta_2, true], [ta_3, false], ["Divergent and Convergent", false]]);

/*Worked Solution*/
/* Define the expression */
expr: den;

/* Extract the exponent */
power: part(expr, 2);

/* Step 2: Set up the improper integral using a limit as t -> 0+ */
new_indef: int(fx, x);   /* Use 'integrate' for the indefinite integral */
upper: at(new_indef, x = upper_limit);
lower: at(new_indef, x = t);
ta: upper - lower;]]></text>
    </questionvariables>
