    </stackversion>
    <questionvariables>
      <text>/*Defining randomised function*/
v_x: rand_with_prohib(-5,5,[0])*x+rand_with_step(-5,5,1);
u_x: rand(3)*x^2+rand_with_prohib(-5,5,[0])*x+rand_with_step(-5,5,1);
f_ction: v_x*%e^(u_x);

/*Worked solution*/
ta: factor(diff(f_ction,x));</text>
