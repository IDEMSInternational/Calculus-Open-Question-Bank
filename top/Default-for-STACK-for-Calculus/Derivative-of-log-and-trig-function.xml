    <questionvariables>
      <text>/*part a*/
coef_cos:rand(2)+2;
coef_sin:rand(4)+2;
a: rand_with_step(1,5,1);
b: rand_with_prohib(1,5,[a]);
quest_expr:coef_cos*cos(a*x)+coef_sin*sin(b*x);
ta1: diff(quest_expr,x);

/*part b*/
u_y: rand(3)*y^2+rand_with_step(-5,5,1)*y+rand_with_step(-5,5,1);
quest_exprresion: ln(u_y);
ta2: diff(quest_exprresion,y);</text>
    </questionvariables>
