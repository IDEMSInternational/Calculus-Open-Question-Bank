    <questionvariables>
      <text>a:rand(10);
b:rand_with_prohib(1,10,[a]);
power:rand(5);
expr:rand([x^power,x^power+x^2+x,x^power+x+a,b*x^power,x^power-a,b*x^power+a]);
func:expr;
ta:int(func,x,a,b);
/*worked solution*/
expr1:int(func,x);
fb:subst(b,x,expr1);
fa:subst(a,x,expr1);
expr2:fb-fa;</text>
    </questionvariables>
