    <questionvariables>
      <text>aa:rand_with_step(0,5,1);
bb: rand_with_step(1,5,1);
cc: rand_with_step(2,7,1);
var1: rand(2)+1; 
func1: x^(var1);
func2: expand((x+aa)*(x+bb)-bb);
func3: expand((x^var1+bb*x+bb));
funct: rand([func1,func2,func3, bb*x+aa,x/bb]);
f(x):=funct;

/*Solutions of the steps*/
ta1a: 1;
sm1a: ev(funct,x=(j));
ta1b:  sum(sm1a,j,1,cc);
ta2a: 1/2;
sm2a: ev(funct,x=0.5*(j));
ta2b: sum(0.5*sm2a,j,1,2*cc)
ta1:(cc-0)/n;
ta2:0+ta1*j;
ta3: expand(ev(funct,x=ta2));

f_xj: expand(ta3*ta1);
ta4: simplify(sum(f_xj,j,1,n));

ta5:int(funct,x,0,cc);</text>
    </questionvariables>
