    <questionvariables>
      <text>/*workdone in calculus*/
force:rand(20)+10;
spring_compress:(rand_with_step(1,8,2)/10);
spring_stretch:(rand_with_step(1,8,1)/10);
/*variables*/
sol1:-force=k(-spring_compress);
sol2:-force/(-spring_compress);
sol3:F(x)=sol2*(x);
sol4:int(sol2*(x),x);
sol5:int(sol2*(x),x,0,spring_stretch);
ta:sol5;</text>
