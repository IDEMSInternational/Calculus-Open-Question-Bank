    <questionvariables>
      <text>/*quadratic Functions*/
constant:rand(6)+3;
aa:rand_with_step(-5,5,1);
bb:1+rand(6);
denom:expand((aa+x)^2+bb^2);
quest_expr:constant/denom;
/* worked solution variables*/
u_squared:(x+aa)^2;
u:x+aa;
denom1:(aa+x)^2+bb^2;
quest_expr2:constant/denom1;
a_squared:bb^2;
a_value:bb;
/*model answer*/
ta:1/b*atan((x+aa)/bb)+c;
ta1:int(quest_expr,x);</text>
    </questionvariables>
