    <questionvariables>
      <text>power_x:rand(5)+1;
coef_x:rand(4)+1;
coef_y:rand(4)+1;
func:(power_x*x^2)*sec(coef_x*x)-(power_x*x^2)/(coef_y*y^3);
gradient_func1:diff((func),x);
gradient_func2:diff((func),y);</text>
    </questionvariables>
