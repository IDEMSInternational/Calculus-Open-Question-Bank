      <text>aa:rand(6)+1;
bb:rand_with_prohib(-5,5,[aa]);
cc:rand_with_prohib(-5,5,[aa,abs(bb)]);
dd:rand_with_prohib(-5,5,[aa,abs(bb),abs(cc)]);
top:expand((x-aa)*(x-bb));
bot:expand((x-aa)*(x-cc)*(x-dd));
dtop:diff(top,x);
dbot:diff(bot,x);
valtop:ev(dtop,x=aa);
valbot:ev(dbot,x=aa);
fx:top/bot;
ta:valtop/valbot;</text>
