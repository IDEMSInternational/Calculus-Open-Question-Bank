    <questionvariables>
      <text>/*Defining the question*/
constant:rand(100)+50; /*random number for the constant*/
power:rand(8)+2; /*random value of n outside the root sign*/

aa:2+rand(5);/*power of x*/
var:constant-x^(aa);
xx:x^(aa-1);
f_x:(xx*(var)^(1/power)); /* the function */

/*Model answers*/
ta_1:int(f_x,x)+c;

/*General feedback codes*/
diff_var:diff(var); /*differentiating var*/
let_u: u^(1/power);
int_u:int(let_u,u);</text>
