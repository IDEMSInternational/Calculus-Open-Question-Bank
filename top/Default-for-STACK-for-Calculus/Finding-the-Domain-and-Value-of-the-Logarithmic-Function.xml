    <questionvariables>
      <text><![CDATA[valx_1:0;
valx_2:rand(8)+1;
valx:rand([valx_1,valx_2]);
ta1: if valx=valx_2 then true else false;
val_valx_2:log(valx_2);
val_2:decimalplaces(float(val_valx_2),2);
ta_2:oo(0,inf);
ta2: if valx=valx_2 then ta_2 else x>0;

ta3_1:random_permutation([["undefined ", true],["well-defined", false]]);
ta3_2:random_permutation([["well-defined", true],["undefined", false]]);

ta3: if valx=valx_1 then ta3_1  else ta3_2;

]]></text>
    </questionvariables>
