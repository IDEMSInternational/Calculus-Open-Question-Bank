    <questionvariables>
      <text>/* Define the function */ 
cfx:(rand([rand(5)+3/(rand(5)+1),(rand(5)+1)/(rand(5)+4)]));
power:rand(3)+2;
cf2:(rand([rand(5)+3,(rand(5)+1)/(rand(5)+4)]));
u:cfx*x^power; diff_u:diff(u,x);
fx:cf2*cos(u); diff_f:-sin(u);
/* Differentiate the function with respect to x */ 
dfx : diff(fx, x);  
/* Model Answers */ 
ta1:simplify(dfx); 
ta2:diff(ta1,x);
ta3:diff(ta2,x);
ta4:diff(ta3,x);
</text>
    </questionvariables>
