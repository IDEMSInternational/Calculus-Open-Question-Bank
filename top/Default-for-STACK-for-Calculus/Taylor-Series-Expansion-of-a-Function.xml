    <questionvariables>
      <text>/*defining question variables*/
aa:rand(4)+1;
bb:rand_with_prohib(1,5,[aa]);
func1:ln(aa+bb*x);
func2:x^aa*e^(bb*x^3);
coef_x:rand(4)+1;
trig:rand([cos,sin]);
func3:trig(coef_x*x);
func:rand([func1,func2,func3]);
/*step 1*/
/*Differentiation of func1*/
f_x:diff(func,x);
f1_x:diff(f_x,x);
f2_x:diff(f1_x,x);
f3_x:diff(f2_x,x);
f4_x:diff(f3_x,x);

/*step 2*/
f_0:subst(0,x,func);/*f(0)*/
f_x_0:subst(0,x,f_x);/*f'(0)*/
f1_x_0:subst(0,x,f1_x);/*f''(0)*/
f2_x_0:subst(0,x,f2_x);/*f'''(0)*/
f3_x_0:subst(0,x,f3_x);/*f''''(0)*/
/*taylor series*/
taylor_series:f_0+(f_x_0)*x+(((f1_x_0)*x^2)/2!)+(((f2_x_0)*x^3)/3!)+(((f3_x_0)*x^4)/4!);
/*model answers*/
ta:taylor_series;</text>
